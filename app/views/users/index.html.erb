<h1>ユーザ一覧</h1>
<% @users.each do |u| %>
  <%= link_to u.uid, user_path(u) %>
  ：<%= u.profile ? u.profile.message : "（プロフィール未登録）" %>
  <%= link_to "削除", user_path(u), data: { turbo_method: :delete, turbo_confirm: "削除しますか？" } %><br>
<% end %>
<%= link_to "新規登録", new_user_path %> |
<%= link_to "トップへ", root_path %>