<h1>プロフィール編集</h1>
<% @profile.errors.full_messages.each do |msg| %>
  <p style="color:red"><%= msg %></p>
<% end %>

<%= form_with model: @profile, url: profile_path, method: :patch do |f| %>
  自己紹介：<%= f.text_field :message, size: 40 %>
  <%= f.submit "保存" %>
<% end %>

<% if @profile.persisted? %>
  <%= link_to "プロフィール削除", profile_path, data: { turbo_method: :delete, turbo_confirm: "削除しますか？" } %> |
<% end %>
<%= link_to "トップへ", root_path %>